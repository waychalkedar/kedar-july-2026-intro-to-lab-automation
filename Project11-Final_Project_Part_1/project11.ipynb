   "source": [
    "arduino = serial.Serial('COM4', 9600, timeout=1)\n",
    "\n",
    "try:\n",
    "    while True:\n",
    "        data = arduino.read(1)\n",
    "        if data:\n",
    "            print(repr(data))\n",
    "except KeyboardInterrupt:\n",
    "    pass\n",
    "finally:\n",
    "    arduino.close()\n",
    "    sys.exit()\n"
   ]
  }
